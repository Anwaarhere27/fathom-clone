####################################################################
# Copy to .env.local and fill in. Never commit the filled-in file.
####################################################################

# ---------- Supabase ----------
# The bare project URL, no path. supabase-js appends /rest/v1 itself.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security. Never import into a client
# component. Used by share pages and the seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Database password from project creation, used by npm run migrate. Passed as a
# config field rather than inside a URI, so special characters need no escaping.
SUPABASE_DB_PASSWORD=
# Only if your project is not in ap-south-1.
# SUPABASE_DB_REGION=ap-south-1

# ---------- Inference (open-weight models via Groq) ----------
GROQ_API_KEY=

# Optional override. Each model has its own daily token budget on the free
# tier, so switching is a way around an exhausted one.
#   openai/gpt-oss-120b   best quality
#   openai/gpt-oss-20b    default
#   qwen/qwen3.8-27b      separate budget, 1k output tokens/minute ceiling
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# ---------- Google Calendar OAuth ----------
# Authorised redirect URI must be <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- App ----------
# Used for OAuth redirects and share links. Must be the deployed origin in
# production, not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
